# ── Database ───────────────────────────────────────────────────────────────────
# Local: postgresql://postgres:password@localhost:5432/auraiq
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/auraiq

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set to your Vercel deployment URL in production
FRONTEND_URL=https://your-app.vercel.app
